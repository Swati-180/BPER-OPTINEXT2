# Copy to server/.env and replace placeholders with real values.
# Do not commit server/.env to source control.

PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/bper
JWT_SECRET=change_me_to_a_strong_secret

# Public frontend URL — used in invite and WDT notification email links
FRONTEND_URL=http://localhost:3001

# Allowed frontend origin for CORS (set to deployed frontend URL in production)
# CORS_ORIGIN=https://your-frontend.example.com

# --- Email Configuration Options ---
# Option 1: Gmail SMTP (Required for production/invite emails)
GMAIL_USER=your_gmail@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password

# Option 2: Mailtrap (Alternative configuration for local testing)
EMAIL_HOST=sandbox.smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USER=your_mailtrap_username
EMAIL_PASS=your_mailtrap_password
EMAIL_FROM="BPER Platform <no-reply@bper.example.com>"
